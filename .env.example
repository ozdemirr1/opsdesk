# Local Compose only. Never reuse hosted or existing development credentials.
# Use four independent random values for this isolated local stack.
OPSDESK_HTTP_PORT=8089
COMPOSE_POSTGRES_PASSWORD=
COMPOSE_APP_PASSWORD=
# At least 32 UTF-8 bytes; generate a unique local value when runtime work begins.
COMPOSE_JWT_SECRET=
# Used only by DB bootstrap and the migration service.
COMPOSE_MIGRATOR_PASSWORD=
