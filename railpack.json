{
  "$schema": "https://schema.railpack.com",
  "provider": "python",
  "packages": {
    "node": "24"
  },
  "steps": {
    "build": {
      "commands": [
        "...",
        "npm --prefix frontend ci --include=dev",
        "VITE_API_BASE_URL=/ npm --prefix frontend run build",
        "rm -rf frontend/node_modules"
      ]
    }
  },
  "deploy": {
    "variables": {
      "OPSDESK_FRONTEND_DIST_DIR": "/app/frontend/dist"
    }
  }
}
