# Exclude everything unless explicitly included.
*

!Dockerfile
!.dockerignore
!pyproject.toml
!uv.lock
!.python-version
!alembic.ini

!src/
!src/**
!migrations/
!migrations/**

# Exclude local artifacts even inside included directories.
**/__pycache__
**/*.py[cod]
**/.env
**/.env.*
**/.venv
**/.git
**/*.pem
**/*.key
